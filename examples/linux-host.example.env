# Copy values like these into the setup command or into an isolated host config.
# Do not commit real hostnames, private IP addresses, credentials, or logs.

GAME_BASE="$HOME/game-stream"
SUNSHINE_DISPLAY=":0"
SUNSHINE_VERSION="v2025.924.154138"
SUNSHINE_APPIMAGE_URL="https://github.com/LizardByte/Sunshine/releases/download/v2025.924.154138/sunshine.AppImage"

# Suggested Steam library path inside the isolated runtime:
STEAM_LIBRARY="$GAME_BASE/steam-library"
